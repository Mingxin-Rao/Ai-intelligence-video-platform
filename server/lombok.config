# Mark Lombok-generated methods with @lombok.Generated so JaCoCo filters them out
# of the coverage report. Generated getters/setters/equals/hashCode/toString were
# ~19% of all instructions in this project; counting them made the real coverage
# of hand-written logic look far worse than it is, and "covering" them would mean
# writing tests that assert Lombok works.
lombok.addLombokGeneratedAnnotation = true
