# =============================================================================
# Template for .env — copy to .env and fill in real values:
#   cp .env.example .env
# .env is gitignored; this template is committed so contributors know what to set.
# =============================================================================

# Gemini (Google AI Studio) — used for AI summaries. Required.
GEMINI_API_KEY=your-gemini-key

# OpenAI — used for Whisper transcripts (leave blank to disable "Extract Text")
OPENAI_API_KEY=

# JWT signing secret — use a long random string, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-secret-string

# Middleware credentials (must match compose.yaml)
MYSQL_PASSWORD=root
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Host port for the app (container port stays 9090). Change if 9090 is taken.
APP_PORT=9090

PROMETHEUS_PORT=9091
GRAFANA_PORT=3001
GRAFANA_PASSWORD=admin
